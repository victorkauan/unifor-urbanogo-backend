# Copie para .env no servidor e preencha antes de subir a stack de producao:
#   docker compose -f docker-compose.prod.yml up -d --build
#   docker compose -f docker-compose.prod.yml --profile tools run --rm migrate
#
# O deploy automatizado (deploy/ansible) gera este arquivo a partir dos
# secrets do GitHub. Ver docs/deploy.md.

POSTGRES_USER=urbanogo
POSTGRES_PASSWORD=
POSTGRES_DB=urbanogo

JWT_SECRET=

LOG_LEVEL=info

# Host publico que o Caddy usa para emitir o certificado TLS.
# Ex.: 203-0-113-10.sslip.io (o app e a API ficam em https://<host>/,
# o Grafana em https://grafana.<host>/).
PUBLIC_HOST=

GRAFANA_ADMIN_PASSWORD=

# Webhook (Slack, Discord, etc.) pro canal do time receber os alertas do Grafana
ALERT_WEBHOOK_URL=

# Opcional: liga a nota de confianca por LLM (DeepInfra). Vazio = fallback pela media.
DEEPINFRA_API_KEY=
