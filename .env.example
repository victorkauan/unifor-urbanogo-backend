# Copie para .env e ajuste conforme necessario.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Postgres (o docker-compose sobe um em localhost:5432)
DATABASE_URL=postgresql://urbanogo:urbanogo@localhost:5432/urbanogo?schema=public

# Redis (o docker-compose sobe um em localhost:6379)
REDIS_URL=redis://localhost:6379

# Segredo para assinar os JWT (minimo 16 caracteres)
JWT_SECRET=troque-este-segredo-no-ambiente

# LLM da nota de confianca (DeepInfra, compativel com OpenAI).
# Sem a chave, a nota cai no calculo simples pela media das avaliacoes.
DEEPINFRA_API_KEY=
DEEPINFRA_TRUST_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct

# Opcional: webhook (Slack, Discord, etc.) pro canal do time receber os
# alertas do Grafana. Sem isso os alertas continuam funcionando, só nao notificam ninguem.
# ALERT_WEBHOOK_URL=
